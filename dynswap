#!/bin/bash

# State file to keep track of created swap files
STATE_FILE="/tmp/dynswap_state.txt"

# Ensure state file exists
touch "$STATE_FILE"

# Function to check and remove empty swap files from the list
cleanup_swap() {
    echo "Checking tracked swap files for emptiness..."
    
    # Read files from our state list
    if [[ ! -s "$STATE_FILE" ]]; then
        echo "No swap files tracked in $STATE_FILE."
        return
    fi

    # Create a temporary file for the updated list
    NEW_STATE_FILE=$(mktemp)

    while IFS= read -r swpfile; do
        if [[ -f "$swpfile" ]]; then
            # Check if the file size is zero or very small (e.g., less than 1KB)
            size_kb=$(du -k "$swpfile" | awk '{print $1}')
            if [ "$size_kb" -le 1 ]; then
                echo "Found empty or near-empty swap file: $swpfile. Deactivating and removing."
                swapoff "$swpfile" 2>/dev/null
                rm -f "$swpfile"
                # Do not add to new state file
            else
                echo "Swap file $swpfile is not empty (Size: ${size_kb}KB)."
                echo "$swpfile" >> "$NEW_STATE_FILE"
            fi
        else
            echo "Swap file $swpfile listed in state file not found on filesystem. Deactivating."
            swapoff "$swpfile" 2>/dev/null
            # Do not add to new state file
        fi
    done < "$STATE_FILE"

    mv "$NEW_STATE_FILE" "$STATE_FILE"
}

# Function to add a new swap file if free memory is low
add_swap() {
    freeram=$(free -b | awk -F' ' 'NR == 2 {print $7}')
    freeswp=$(free -b | awk -F' ' 'NR == 3 {print$4}')
    freetot=$(($freeram + $freeswp))

    # Threshold: 1GB = 1073741824 bytes
    threshold=1073741824

    if (($freetot < $threshold)); then
        echo "Low memory detected (Total free: $((freetot / 1024 / 1024)) MB). Creating new swap file..."
        swpfile="/tmp/swp$RANDOM"
        dd if=/dev/zero of="$swpfile" bs=4096K count=256 status=none
        chown root "$swpfile"
        chmod 0600 "$swpfile"
        mkswap "$swpfile"
        swapon "$swpfile"
        echo "New swap file created and activated: $swpfile"
        echo "$swpfile" >> "$STATE_FILE"
    fi
}

# Main execution: First clean up existing, then check if we need to add more
cleanup_swap
add_swap
